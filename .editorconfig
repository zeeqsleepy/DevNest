# Cross-editor formatting, so contributors on different platforms and editors
# stop producing whitespace-only diffs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Go uses tabs. gofmt decides this, not us.
[*.go]
indent_style = tab
indent_size = 4

[go.mod]
indent_style = tab

# Makefiles require tabs for recipe lines.
[Makefile]
indent_style = tab

[*.{md,markdown}]
indent_size = 2
# Two trailing spaces are a Markdown line break and must survive.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

[*.ps1]
# PowerShell scripts run on Windows and are more predictable with CRLF.
end_of_line = crlf
indent_size = 4

[*.sh]
end_of_line = lf
indent_size = 2

[*.bat]
end_of_line = crlf
